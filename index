<div class="toast" id="toast"></div>
<div class="modal" id="modal">
  <div class="modal-box">
    <h3 id="modalTitle">Vehicle lookup</h3>
    <p id="modalText" style="font-size:13px;color:var(--muted);line-height:1.6"></p>
    <div style="text-align:right;margin-top:22px"><button class="btn btn-primary" onclick="closeModal()">Continue</button></div>
  </div>
</div>

<script>
let currentStep=1;
let policyType='new';
let plan='comprehensive';
let addons={zero:true,rsa:false,engine:false,consumables:false};
let addonPrices={zero:350,rsa:180,engine:420,consumables:120};

function money(n){return '₹'+Math.round(n).toLocaleString('en-IN')}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='block';clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.style.display='none',2600)}
function openModal(title,text){document.getElementById('modalTitle').textContent=title;document.getElementById('modalText').textContent=text;document.getElementById('modal').style.display='flex'}
function closeModal(){document.getElementById('modal').style.display='none'}

function formatReg(el){
  el.value=el.value.toUpperCase().replace(/[^A-Z0-9]/g,'');
  if(el.value.length>=8){document.getElementById('next1').disabled=false}
}
/*
 * UIIC VEHICLE LOOKUP ADAPTER
 * ---------------------------
 * The saved GoDigit source shows the motor journey collecting the registration
 * number as licensePlateNumber and using its motor vehicle / VAHAN flow.
 * It does NOT expose the underlying private vehicle-service endpoint in the
 * supplied HTML. Therefore no undocumented GoDigit endpoint is hard-coded here.
 *
 * For the UIIC bid, point this adapter to UIIC's authorised VAHAN / RC service:
 *
 * window.UIIC_CONFIG = {
 *   vehicleLookupEndpoint: "/api/vehicle-lookup"
 * };
 *
 * Expected response (normalised by the UIIC backend):
 * {
 *   verified: true,
 *   registrationNumber: "KA20AB1234",
 *   manufacturer: "HYUNDAI MOTOR INDIA LTD",
 *   model: "CRETA",
 *   variant: "SX(O)",
 *   fuelType: "PETROL",
 *   vehicleClass: "Motor Car",
 *   registrationDate: "2023-05-14",
 *   rto: "UDUPI RTO",
 *   insuranceUpto: "2027-05-13",
 *   pucUpto: "2026-12-31",
 *   chassisNumberMasked: "***************123",
 *   engineNumberMasked: "********456"
 * }
 *
 * IMPORTANT: Do not put VAHAN/vendor API keys in this HTML. The lookup must
 * be performed server-side with authorised credentials and only the fields
 * needed for insurance quotation should be returned to the browser.
 */
window.UIIC_CONFIG = window.UIIC_CONFIG || {
  vehicleLookupEndpoint: "/api/vehicle-lookup"
};

let vehicleData = null;

function normaliseVehicleResponse(raw, reg){
  const d = raw && (raw.data || raw.result || raw.vehicle || raw);
  if(!d || d.verified === false) return null;
  return {
    verified: d.verified !== false,
    registrationNumber: d.registrationNumber || d.registration_number || d.reg_no || d.rc_number || reg,
    manufacturer: d.manufacturer || d.vehicle_manufacturer_name || d.maker || d.makerDescription || "",
    model: d.model || d.maker_model || d.vehicleModel || d.modelName || "",
    variant: d.variant || d.vehicle_variant || "",
    fuelType: d.fuelType || d.fuel_type || "",
    vehicleClass: d.vehicleClass || d.vehicle_class || d.class || "",
    registrationDate: d.registrationDate || d.registration_date || d.registered || "",
    rto: d.rto || d.registered_at || d.rtoName || "",
    insuranceUpto: d.insuranceUpto || d.insurance_upto || d.insurance_validity || "",
    pucUpto: d.pucUpto || d.puc_upto || d.pollution_control_validity || "",
    chassisNumberMasked: d.chassisNumberMasked || d.chassis_masked || d.chassis || "",
    engineNumberMasked: d.engineNumberMasked || d.engine_masked || d.engine || ""
  };
}

function setVehicleLookupState(title,text,verified=false){
  document.getElementById('vehicleResult').style.display='block';
  document.getElementById('vehicleStatusTitle').textContent=title;
  document.getElementById('vehicleStatusText').textContent=text;
  document.getElementById('vehicleVerifiedBadge').style.display=verified?'inline-block':'none';
}

function renderVehicleData(d){
  const grid=document.getElementById('vehicleDetailsGrid');
  const fields=[
    ['Registration',d.registrationNumber],
    ['Manufacturer',d.manufacturer],
    ['Model',d.model],
    ['Variant',d.variant],
    ['Fuel',d.fuelType],
    ['Vehicle class',d.vehicleClass],
    ['Registration date',d.registrationDate],
    ['RTO',d.rto],
    ['Insurance valid till',d.insuranceUpto],
    ['PUC valid till',d.pucUpto],
    ['Chassis',d.chassisNumberMasked],
    ['Engine',d.engineNumberMasked]
  ].filter(x=>x[1]);

  grid.innerHTML=fields.map(([k,v])=>`<div class="vehicle-detail"><span>${escapeHtml(k)}</span><b>${escapeHtml(v)}</b></div>`).join('');
  grid.style.display=fields.length?'grid':'none';

  // Persist only non-sensitive vehicle information needed by the quote journey.
  try{localStorage.setItem('uiicVehicleData',JSON.stringify(d))}catch(e){}
}

function escapeHtml(v){
  return String(v ?? '').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
}

async function lookupVehicle(){
  const reg=document.getElementById('regNo').value.trim().toUpperCase().replace(/[^A-Z0-9]/g,'');
  if(!/^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{1,4}$/.test(reg)){
    toast('Please enter a valid Indian vehicle registration number.');
    return;
  }

  document.getElementById('next1').disabled=true;
  setVehicleLookupState('Verifying vehicle…','Checking the registration number against the connected vehicle service.');
  const endpoint=window.UIIC_CONFIG && window.UIIC_CONFIG.vehicleLookupEndpoint;

  if(!endpoint){
    setVehicleLookupState('Vehicle service not configured','Connect the UIIC vehicle / VAHAN service to verify this registration.');
    return;
  }

  try{
    const response=await fetch(endpoint,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({registrationNumber:reg,vehicleType:'PRIVATE_CAR'})
    });

    if(!response.ok) throw new Error('Vehicle service returned HTTP '+response.status);
    const raw=await response.json();
    const data=normaliseVehicleResponse(raw,reg);

    if(!data || !data.verified){
      throw new Error('Vehicle could not be verified');
    }

    vehicleData=data;
    renderVehicleData(data);
    setVehicleLookupState(
      'Vehicle verified',
      `${data.manufacturer || ''} ${data.model || ''}${data.variant?' • '+data.variant:''}`.trim() || 'Verified registration record',
      true
    );
    document.getElementById('next1').disabled=false;
    toast('Vehicle verified successfully.');
  }catch(error){
    console.error(error);
    vehicleData=null;
    setVehicleLookupState(
      'Vehicle could not be verified',
      'We could not retrieve a verified RC record. Please check the registration number or try again.'
    );
    document.getElementById('next1').disabled=true;
    toast('Vehicle verification failed.');
  }
}

function manualVehicle(){
  openModal(
    'Manual vehicle entry',
    'Manual entry is available for cases where the registration number is unavailable. For a production UIIC journey, the vehicle details should still be validated through the authorised vehicle / RC service before premium calculation or policy issuance.'
  );
}
function startQuote(intent='buy'){
  document.getElementById('landingPage').style.display='none';
  document.getElementById('quoteApp').style.display='block';
  policyType = intent==='renew' ? 'renew' : 'new';
  go(1);
  const reg=document.getElementById('regNo');
  if(reg) reg.focus();
  toast(intent==='renew'?'Motor renewal journey started.':'New motor quote started.');
}
function startNew(){
  document.getElementById('landingPage').style.display='none';
  document.getElementById('quoteApp').style.display='block';
  currentStep=1;
  vehicleData=null;
  document.querySelectorAll('input').forEach(i=>{if(i.type!=='checkbox'&&i.type!=='range')i.value=''});
  document.getElementById('vehicleResult').style.display='none';
  document.getElementById('next1').disabled=true;
  go(1);
  toast('New motor quote started.');
}
function resumeJourney(){
  const saved=localStorage.getItem('uiicMotorJourney');
  if(saved){const d=JSON.parse(saved);if(d.step)go(Math.min(d.step,6));toast('Saved journey restored.');}
  else openModal('No saved journey','There is no saved quote on this browser. Start a new quote to begin.');
}
function saveJourney(){
  localStorage.setItem('uiicMotorJourney',JSON.stringify({step:currentStep,plan,addons}));
}
function go(step){
  if(step===2 && !vehicleData){toast('Please verify the vehicle before continuing.');return}
  if(step===1 || step===2 || step===3 || step===4 || step===5 || step===6 || step===7){
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('panel'+step).classList.add('active');
    currentStep=step;
    document.querySelectorAll('.step').forEach(s=>{
      const n=Number(s.dataset.step);
      s.classList.toggle('active',n===Math.min(step,6));
      s.classList.toggle('done',n<step);
    });
    saveJourney();
    window.scrollTo({top:0,behavior:'smooth'});
    if(step===5)refreshReview();
    if(step===6)document.getElementById('payTotal').textContent=document.getElementById('grandTotal').textContent;
  }
}
function choosePolicy(type,el){
  policyType=type;
  document.querySelectorAll('#panel2 .choice').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');
}
function selectPlan(p,el){
  plan=p;
  document.querySelectorAll('.plan').forEach(x=>x.classList.remove('selected'));
  el.classList.add('selected');
  updatePremium();
}
function updateIDV(){
  const v=Number(document.getElementById('idv').value);
  document.getElementById('idvValue').textContent=money(v);
  updatePremium();
}
function toggleAddon(btn,key,price){
  addons[key]=!addons[key];
  btn.classList.toggle('on',addons[key]);
  updatePremium();
}
function updatePremium(){
  const idv=Number(document.getElementById('idv').value);
  let base=plan==='comprehensive' ? 10240 + Math.round((idv-820000)/10000)*35 : 3150;
  base=Math.max(plan==='comprehensive'?7800:3150,base);
  let add=0;Object.keys(addons).forEach(k=>{if(addons[k])add+=addonPrices[k]});
  const gst=Math.round((base+add)*.18);
  const total=base+add+gst;
  document.getElementById('basePremium').textContent=money(base);
  document.getElementById('addonTotal').textContent=money(add);
  document.getElementById('gst').textContent=money(gst);
  document.getElementById('grandTotal').textContent=money(total);
  document.getElementById('reviewTotal').textContent=money(total);
  document.getElementById('payTotal').textContent=money(total);
  document.getElementById('successTotal').textContent=money(total);
}
function validateDetails(){
  const fields=['firstName','lastName','mobile','email','pincode','city','address'];
  const missing=fields.find(id=>!document.getElementById(id).value.trim());
  if(missing){toast('Please complete the highlighted customer details.');document.getElementById(missing).focus();return}
  if(!/^[0-9]{10}$/.test(document.getElementById('mobile').value.trim())){toast('Please enter a valid 10-digit mobile number.');return}
  if(!document.getElementById('consent').checked){toast('Please accept the proposal declaration to continue.');return}
  go(5);
}
function suggestAddress(){
  const p=document.getElementById('pincode').value;
  if(p.length===6){document.getElementById('addressHint').textContent='Address suggestions can be fetched from a PIN-code service in production.'}
  else document.getElementById('addressHint').textContent='';
}
function refreshReview(){
  const f=document.getElementById('firstName').value;
  const l=document.getElementById('lastName').value;
  const m=document.getElementById('mobile').value;
  const e=document.getElementById('email').value;
  const a=document.getElementById('address').value;
  document.getElementById('reviewPerson').innerHTML='<b>'+f+' '+l+'</b><br>'+m+' • '+e+'<br>'+a+', '+document.getElementById('city').value+' - '+document.getElementById('pincode').value;
  document.getElementById('reviewPlan').textContent=plan==='comprehensive'?'Comprehensive':'Third-party';
  if(vehicleData){
    const vehicleName=[vehicleData.manufacturer,vehicleData.model,vehicleData.variant].filter(Boolean).join(' ');
    document.getElementById('reviewVehicle').textContent=(vehicleData.registrationNumber||'')+' • '+(vehicleName||'Verified vehicle');
    document.getElementById('successVehicle').textContent=(vehicleData.registrationNumber||'')+' • '+(vehicleName||'Verified vehicle');
    document.getElementById('payVehicle').textContent=vehicleData.registrationNumber||'Verified vehicle';
  }
  document.getElementById('reviewIDV').textContent=money(Number(document.getElementById('idv').value));
  const names={zero:'Zero Depreciation',rsa:'Roadside Assistance',engine:'Engine & Gearbox Protection',consumables:'Consumables Cover'};
  const selected=Object.keys(addons).filter(k=>addons[k]).map(k=>names[k]);
  document.getElementById('reviewAddons').textContent=selected.length?selected.join(', '):'None';
  updatePremium();
}
function selectPayment(el){
  document.querySelectorAll('.payment').forEach(x=>x.classList.remove('selected'));el.classList.add('selected');
}
function payNow(){
  if(!document.getElementById('paymentRef').value.trim()){toast('Enter a payment reference / UPI ID to simulate payment.');return}
  const number='UIIC-MTR-2026-'+Math.floor(100000+Math.random()*899999);
  document.getElementById('policyNumber').textContent=number;
  go(7);
  localStorage.removeItem('uiicMotorJourney');
  toast('Payment successful. Policy issued.');
}
function downloadPolicy(){
  const number=document.getElementById('policyNumber').textContent;
  const content='UNITED INDIA INSURANCE COMPANY LTD.\\n\\nMOTOR INSURANCE POLICY - DIGITAL COPY\\nPolicy Number: '+number+'\\nVehicle: KA 20 AB 1234\\nPlan: '+(plan==='comprehensive'?'Comprehensive':'Third-party')+'\\nPremium Paid: '+document.getElementById('successTotal').textContent+'\\n\\nThis is a prototype policy document generated for the UIIC digital journey demonstration.';
  const blob=new Blob([content],{type:'text/plain'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=number+'.txt';a.click();URL.revokeObjectURL(a.href);
}
function emailPolicy(){toast('Demo: policy copy queued for email delivery.')}
updatePremium();
</script>
