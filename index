<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UIIC Motor Insurance | New Age Buying Journey</title>
<style>
:root{
  --uiic-blue:#0b2b72;
  --uiic-blue-2:#1649a0;
  --uiic-yellow:#ffc400;
  --uiic-yellow-2:#ffb300;
  --ink:#172033;
  --muted:#687386;
  --line:#dce2eb;
  --bg:#f4f7fb;
  --white:#fff;
  --success:#16845b;
  --danger:#c63c3c;
  --shadow:0 12px 36px rgba(12,35,82,.10);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
button,input,select{font:inherit}
button{cursor:pointer}
.top-strip{height:30px;background:#111;color:#fff;display:flex;align-items:center;justify-content:flex-end;padding:0 24px;font-size:12px}
.top-strip span{color:var(--uiic-yellow)}
.utility{height:68px;background:var(--uiic-blue);color:#fff;display:flex;align-items:center;padding:0 30px;gap:28px}
.utility .links{font-weight:700;font-size:14px;flex:1}
.utility .links span{margin-right:18px}
.utility .right{display:flex;align-items:center;gap:18px;font-size:12px}
.header{height:108px;background:var(--uiic-yellow);display:flex;align-items:center;padding:0 30px;gap:28px}
.brand{display:flex;align-items:center;gap:12px;min-width:390px}
.brand-mark{width:54px;height:54px;border-radius:50%;background:#fff;border:4px solid var(--uiic-blue);display:grid;place-items:center;color:var(--uiic-blue);font-weight:900;font-size:12px;text-align:center;line-height:1}
.brand-title{font-weight:800;color:var(--uiic-blue);font-size:19px;line-height:1.1}
.brand-sub{font-size:11px;color:#5b4a00;margin-top:4px}
.nav{display:flex;background:#0a2c78;border-radius:28px;padding:5px;margin-left:auto}
.nav button{border:0;background:transparent;color:#fff;padding:12px 18px;font-size:12px;font-weight:800}
.nav button.active{background:#fff;color:var(--uiic-blue)}

.brand-logo-img{width:58px;height:58px;object-fit:contain}
.landing{display:block;background:#fff}
.landing-top{height:30px;background:#111}
.landing-hero{display:grid;grid-template-columns:1fr 1fr;min-height:390px}
.landing-promo{position:relative;overflow:hidden;background:linear-gradient(180deg,#51565a,#050708);display:flex;align-items:center;justify-content:center;padding:30px}
.landing-promo:after{content:"";position:absolute;inset:auto 0 0;height:45%;background:linear-gradient(transparent,#030405);pointer-events:none}
.promo-image{width:44%;max-width:370px;height:230px;object-fit:cover;object-position:center;border:1px solid #a76c17;box-shadow:0 0 0 7px rgba(0,0,0,.28)}
.promo-copy{position:relative;z-index:2;color:#fff;margin-left:35px;max-width:410px}
.promo-copy h2{font-size:25px;line-height:1.25;font-weight:500;margin:0}
.promo-copy em{font-weight:900}
.landing-policy{background:linear-gradient(135deg,#183f8e,#0b286b);color:#fff;padding:32px 50px;position:relative}
.policy-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px;align-items:start}
.policy-icon{height:95px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:none;border:0;color:#fff}
.policy-circle{width:92px;height:92px;border:2px solid #e8cba0;border-radius:50%;display:grid;place-items:center;font-size:30px;margin-bottom:9px;background:rgba(0,0,0,.08)}
.policy-icon.active .policy-circle{background:#6e3e40;border-color:#fff}
.policy-icon span{font-size:12px;line-height:1.2}
.policy-more{grid-column:3;margin-top:22px}
.landing-social{position:absolute;right:15px;top:14px;display:flex;flex-direction:column;gap:10px}
.social-dot{width:36px;height:36px;border-radius:50%;background:#fff;color:#1649a0;display:grid;place-items:center;font-weight:900;font-size:13px}
.landing-actions{display:grid;grid-template-columns:1fr 1fr}
.stats{background:#f2fbfd;display:flex;justify-content:space-around;align-items:center;padding:30px 70px;gap:30px}
.stat{text-align:center;color:#172033}
.stat-circle{width:82px;height:82px;border-radius:50%;background:#073da1;color:#fff;display:grid;place-items:center;margin:0 auto 10px;font-size:24px;font-weight:900}
.stat strong{font-size:14px;display:block}
.stat span{font-size:12px;color:#333}
.buy-panel{background:linear-gradient(135deg,#ffbd20,#ffad12);padding:32px;display:flex;flex-direction:column;align-items:center;justify-content:center}
.buy-panel h3{margin:0 0 18px;font-size:16px;color:#000}
.buy-toggle{display:flex;gap:28px;margin-bottom:16px;font-size:14px}
.buy-toggle label{display:flex;align-items:center;gap:8px;font-weight:600;color:#000}
.buy-toggle input{width:20px;height:20px}
.buy-buttons{display:flex;gap:9px}
.landing-btn{border:0;background:#fff;padding:12px 18px;font-size:12px;font-weight:800;color:#18233d}
.landing-btn.primary{background:#092c76;color:#fff}
.awards{background:#f2fbfd;padding:32px 7% 60px}
.awards h2{text-align:center;color:#1649a0;font-size:25px;font-weight:500;margin:0 0 28px}
.award-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.award-card{background:#e6e7e8;padding:28px 30px 20px;min-height:220px;position:relative}
.award-card:before{content:"★";position:absolute;top:-23px;left:50%;transform:translateX(-50%);width:54px;height:45px;background:#fff;color:#ffb31b;text-align:center;line-height:45px;font-size:25px}
.award-card img{width:100%;height:170px;object-fit:cover;display:block}
.landing-disclaimer{font-size:10px;color:#666;padding:0 20px 20px;text-align:center}
@media(max-width:900px){
 .landing-hero,.landing-actions{grid-template-columns:1fr}.policy-grid{grid-template-columns:repeat(3,1fr)}
 .policy-more{grid-column:2}.promo-copy{margin:20px 0 0}.promo-image{width:55%}
 .stats{padding:25px 15px}.award-grid{grid-template-columns:1fr}
}

.page{display:none;max-width:1440px;margin:0 auto;padding:28px 34px 50px}
.hero{background:linear-gradient(105deg,#0a2a70 0%,#1649a0 58%,#0c2c72 100%);color:#fff;padding:34px 38px;display:flex;justify-content:space-between;align-items:center;min-height:190px;box-shadow:var(--shadow)}
.hero h1{margin:0 0 10px;font-size:34px;letter-spacing:-.6px}
.hero p{margin:0;color:#dce8ff;font-size:15px;max-width:650px;line-height:1.55}
.hero-actions{display:flex;gap:12px}
.btn{border:0;padding:13px 20px;font-weight:800;font-size:13px}
.btn-primary{background:var(--uiic-yellow);color:#101f45}
.btn-secondary{background:#fff;color:var(--uiic-blue)}
.btn-outline{background:transparent;color:var(--uiic-blue);border:1px solid #b9c4d4}
.btn-danger{background:#fff0f0;color:#a32626}
.workflow{margin-top:22px;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow)}
.steps{display:flex;border-bottom:1px solid var(--line);overflow:auto}
.step{min-width:155px;flex:1;padding:18px 14px;position:relative;color:#8791a3;background:#fff}
.step:after{content:"";position:absolute;right:0;top:0;width:1px;height:100%;background:var(--line)}
.step:last-child:after{display:none}
.step .num{width:28px;height:28px;border:2px solid #c7ced9;display:inline-grid;place-items:center;font-weight:900;margin-right:8px;font-size:12px}
.step strong{font-size:12px}
.step.active{color:var(--uiic-blue);background:#f7f9fd}
.step.active .num{border-color:var(--uiic-blue);background:var(--uiic-blue);color:#fff}
.step.done{color:var(--success)}
.step.done .num{border-color:var(--success);background:var(--success);color:#fff}
.content{padding:28px}
.panel{display:none}
.panel.active{display:block}
.section-title{font-size:22px;color:var(--uiic-blue);margin:0 0 5px}
.section-sub{color:var(--muted);font-size:13px;margin:0 0 24px}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}
.col-3{grid-column:span 3}.col-4{grid-column:span 4}.col-6{grid-column:span 6}.col-8{grid-column:span 8}.col-12{grid-column:span 12}
.card{background:#fff;border:1px solid var(--line);padding:20px}
.card.soft{background:#f8faff}
label{display:block;font-size:12px;font-weight:800;margin:0 0 7px;color:#34415a}
input,select{width:100%;height:46px;border:1px solid #cbd3df;background:#fff;padding:0 13px;color:#172033;outline:none}
input:focus,select:focus{border-color:var(--uiic-blue);box-shadow:0 0 0 3px rgba(22,73,160,.09)}
.field{margin-bottom:16px}
.help{font-size:11px;color:var(--muted);margin-top:6px}
.choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.choice{border:1px solid var(--line);padding:16px;background:#fff;position:relative;text-align:left}
.choice:hover{border-color:var(--uiic-blue)}
.choice.selected{border:2px solid var(--uiic-blue);background:#f5f8ff}
.choice .tick{position:absolute;right:10px;top:10px;width:20px;height:20px;background:var(--uiic-blue);color:#fff;display:none;place-items:center;font-size:12px}
.choice.selected .tick{display:grid}
.choice h3{font-size:14px;margin:0 0 6px;color:var(--uiic-blue)}
.choice p{font-size:12px;color:var(--muted);margin:0;line-height:1.4}

.vehicle-result{min-height:78px}
.vehicle-detail{background:#fff;border:1px solid var(--line);padding:10px}
.vehicle-detail span{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:800;margin-bottom:4px}
.vehicle-detail b{display:block;font-size:12px;color:var(--uiic-blue);word-break:break-word}
.service-note{font-size:10px;color:var(--muted);margin-top:10px}
.vehicle-result{border-left:5px solid var(--uiic-yellow);background:#fffbea;padding:16px;margin-top:12px;display:none}
.vehicle-result strong{color:var(--uiic-blue)}
.toggle-row{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line);padding:15px;margin-bottom:10px}
.switch{width:44px;height:24px;background:#c8ced8;position:relative;border:0}
.switch:after{content:"";position:absolute;width:18px;height:18px;background:#fff;top:3px;left:3px;transition:.2s}
.switch.on{background:var(--uiic-blue)}
.switch.on:after{left:23px}
.addon-price{font-weight:800;color:var(--uiic-blue)}
.quote-layout{display:grid;grid-template-columns:1.45fr .8fr;gap:20px}
.summary{position:sticky;top:15px;background:#0a2b70;color:#fff;padding:24px}
.summary h3{margin:0 0 18px;font-size:18px}
.summary-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.18);font-size:12px}
.summary-row.total{border:0;padding-top:18px;font-size:18px;font-weight:900}
.yellow-box{background:var(--uiic-yellow);color:#10234e;padding:16px;margin-top:14px}
.range-wrap{padding:10px 0}
input[type=range]{height:auto;padding:0;accent-color:var(--uiic-blue)}
.idv-value{font-size:24px;color:var(--uiic-blue);font-weight:900}
.timeline{border-left:3px solid var(--uiic-yellow);padding-left:18px}
.timeline-item{margin-bottom:20px;position:relative}
.timeline-item:before{content:"";position:absolute;left:-27px;top:1px;width:11px;height:11px;background:var(--uiic-blue);border:3px solid #fff;box-shadow:0 0 0 1px var(--uiic-blue)}
.timeline-item strong{font-size:13px}
.timeline-item p{font-size:12px;color:var(--muted);margin:5px 0 0}
.footer-actions{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);margin-top:28px;padding-top:20px}
.secure{font-size:12px;color:var(--muted)}
.payment-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.payment{border:1px solid var(--line);padding:18px;background:#fff;text-align:left}
.payment.selected{border:2px solid var(--uiic-blue);background:#f6f9ff}
.success{padding:38px;text-align:center}
.success-icon{width:72px;height:72px;border-radius:50%;background:#e6f7ef;color:var(--success);display:grid;place-items:center;font-size:34px;font-weight:900;margin:0 auto 18px}
.success h2{color:var(--uiic-blue);margin:0 0 10px}
.policy-number{font-size:22px;font-weight:900;color:#111f42;background:#f5f7fb;padding:14px;margin:18px auto;max-width:460px}
.toast{position:fixed;right:24px;bottom:24px;background:#122c68;color:#fff;padding:14px 18px;display:none;box-shadow:var(--shadow);z-index:50;font-size:13px}
.modal{position:fixed;inset:0;background:rgba(4,15,35,.62);display:none;align-items:center;justify-content:center;z-index:40}
.modal-box{width:min(620px,92vw);background:#fff;padding:28px;box-shadow:var(--shadow)}
.modal-box h3{margin-top:0;color:var(--uiic-blue)}
@media(max-width:900px){
 .utility .links{display:none}.brand{min-width:auto}.brand-title{font-size:15px}.nav{display:none}
 .hero{display:block}.hero-actions{margin-top:20px}.quote-layout{grid-template-columns:1fr}
 .grid{display:block}.col-3,.col-4,.col-6,.col-8,.col-12{width:100%}
 .choice-grid,.payment-options{grid-template-columns:1fr}
 .summary{position:static;margin-top:20px}
}
</style>
</head>
<body>
<div class="top-strip"><span>Recruitment of Administrative Officers - Gener | &nbsp; Official UIIC Digital Experience</span></div>
<div class="utility">
  <div class="links"><span>About Us</span><span>Information Center</span><span>Public Disclosures</span><span>Tenders / RFP</span><span>Vigilance</span></div>
  <div class="right"><b>1800 425 333 33</b><span>10 AM - 5:45 PM</span><span>Screen Reader Access</span><span>A- A A+</span></div>
</div>
<header class="header">
  <div class="brand">
    <img class="brand-logo-img" src="data:image/png;base64," alt="United India Insurance Company Limited logo">
    <div><div class="brand-title">UNITED INDIA INSURANCE COMPANY LTD.</div><div class="brand-sub">At United India, it's always U before me</div></div>
  </div>
  <nav class="nav">
    <button>HOME</button><button class="active">MOTOR</button><button>CLAIMS</button><button>CUSTOMER SERVICES</button><button>CONTACT US</button><button>LOGIN</button>
  </nav>
</header>


<section class="landing" id="landingPage">
  <div class="landing-top"></div>
  <section class="landing-hero">
    <div class="landing-promo">
      <img class="promo-image" src="data:image/png;base64," alt="UIIC award recognition">
      <div class="promo-copy">
        <h2>WE ARE HONORED TO BE INCLUDED ON THE FORBES AND STATISTA <em>WORLD'S BEST INSURANCE COMPANIES 2026</em> AWARD LIST</h2>
      </div>
    </div>
    <div class="landing-policy">
      <div class="policy-grid">
        <button class="policy-icon active" onclick="startQuote('buy')"><div class="policy-circle">🚗</div><span>Motor</span></button>
        <div class="policy-icon"><div class="policy-circle">♡</div><span>Health</span></div>
        <div class="policy-icon"><div class="policy-circle">♙</div><span>Personal<br>Accident</span></div>
        <div class="policy-icon"><div class="policy-circle">⌂</div><span>Fire Policy</span></div>
        <div class="policy-icon"><div class="policy-circle">✈</div><span>Overseas<br>Mediclaim</span></div>
        <div class="policy-icon policy-more"><div class="policy-circle">＋</div><span>More Policy</span></div>
      </div>
      <div class="landing-social">
        <div class="social-dot">f</div><div class="social-dot">◎</div><div class="social-dot">▶</div><div class="social-dot">𝕏</div><div class="social-dot">⌖</div>
      </div>
    </div>
  </section>
  <section class="landing-actions">
    <div class="stats">
      <div class="stat"><div class="stat-circle">♙</div><strong>13,87,102</strong><span>No.of Policy Holders</span></div>
      <div class="stat"><div class="stat-circle">⚖</div><strong>24,27,073</strong><span>No.of Claim Settled</span></div>
      <div class="stat"><div class="stat-circle">▣</div><strong>1545</strong><span>Office Network</span></div>
    </div>
    <div class="buy-panel">
      <h3>Are you looking to?</h3>
      <div class="buy-toggle">
        <label><input type="radio" name="landingIntent" checked> Buy</label>
        <label><input type="radio" name="landingIntent"> Renewal</label>
      </div>
      <div class="buy-buttons">
        <button class="landing-btn primary" onclick="startQuote('buy')">BUY</button>
        <button class="landing-btn" onclick="startQuote('renew')">RENEW</button>
        <button class="landing-btn" onclick="toast('Claims module can be connected here.')">CLAIM</button>
        <button class="landing-btn" onclick="toast('Customer service module can be connected here.')">KNOW MORE</button>
      </div>
    </div>
  </section>
  <section class="awards">
    <h2>Awards &amp; Recognitions</h2>
    <div class="award-grid">
      <div class="award-card"><img src="data:image/png;base64," alt="UIIC award recognition"></div>
      <div class="award-card"><img src="data:image/png;base64," alt="UIIC award recognition"></div>
      <div class="award-card"><img src="data:image/png;base64," alt="UIIC award recognition"></div>
    </div>
    <div class="landing-disclaimer">Insurance is the subject matter of solicitation. This prototype is for UIIC digital transformation proposal demonstration.</div>
  </section>
</section>

<main class="page" id="quoteApp">
  <section class="hero">
    <div>
      <h1>Motor Insurance, reimagined.</h1>
      <p>A faster, simpler digital journey for buying or renewing your UIIC motor policy. Start with your vehicle number and get to a personalised quote in minutes.</p>
    </div>
    <div class="hero-actions">
      <button class="btn btn-secondary" onclick="resumeJourney()">Resume saved journey</button>
      <button class="btn btn-primary" onclick="startNew()">Start new quote</button>
    </div>
  </section>

  <section class="workflow">
    <div class="steps" id="steps">
      <div class="step active" data-step="1"><span class="num">1</span><strong>Vehicle</strong></div>
      <div class="step" data-step="2"><span class="num">2</span><strong>Policy</strong></div>
      <div class="step" data-step="3"><span class="num">3</span><strong>Coverage</strong></div>
      <div class="step" data-step="4"><span class="num">4</span><strong>Your details</strong></div>
      <div class="step" data-step="5"><span class="num">5</span><strong>Review</strong></div>
      <div class="step" data-step="6"><span class="num">6</span><strong>Payment</strong></div>
    </div>

    <div class="content">
      <!-- STEP 1 -->
      <section class="panel active" id="panel1">
        <h2 class="section-title">Tell us about your vehicle</h2>
        <p class="section-sub">Enter your registration number once. The connected vehicle service verifies the RC and pre-fills the journey. No repeated vehicle forms.</p>
        <div class="grid">
          <div class="col-8">
            <div class="card">
              <div class="field">
                <label>Vehicle registration number</label>
                <input id="regNo" placeholder="e.g. KA20AB1234" maxlength="12" oninput="formatReg(this)">
                <div class="help">Enter your registration number. Example: KA 20 AB 1234. Vehicle details are populated only after verification.</div>
              </div>
              <button class="btn btn-primary" onclick="lookupVehicle()">Find my vehicle</button>
              <div class="vehicle-result" id="vehicleResult">
                <div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start">
                  <div>
                    <strong id="vehicleStatusTitle">Vehicle lookup</strong>
                    <div id="vehicleStatusText" style="font-size:12px;color:#687386;margin-top:5px">Enter a registration number and verify it against the connected vehicle service.</div>
                  </div>
                  <span id="vehicleVerifiedBadge" style="display:none;background:#e7f7ef;color:#16845b;padding:5px 9px;font-size:10px;font-weight:900">VERIFIED</span>
                </div>
                <div id="vehicleDetailsGrid" style="display:none;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:15px"></div>
              </div>
            </div>
          </div>
          <div class="col-4">
            <div class="card soft">
              <h3 style="margin-top:0;color:var(--uiic-blue)">Don't have the number?</h3>
              <p style="font-size:12px;color:var(--muted);line-height:1.5">You can also begin with make, model and registration details. The journey will remember your progress.</p>
              <button class="btn btn-outline" onclick="manualVehicle()">Enter vehicle manually</button>
            </div>
          </div>
        </div>
        <div class="footer-actions">
          <span class="secure">Secure digital journey • Your information is used only for this quote</span>
          <button class="btn btn-primary" id="next1" disabled onclick="go(2)">Continue</button>
        </div>
      </section>

      <!-- STEP 2 -->
      <section class="panel" id="panel2">
        <h2 class="section-title">What's your policy situation?</h2>
        <p class="section-sub">We use this to determine the right cover and applicable pricing.</p>
        <div class="choice-grid">
          <button class="choice selected" id="policy-new" onclick="choosePolicy('new',this)">
            <span class="tick">✓</span><h3>New vehicle / First policy</h3><p>I am buying insurance for a vehicle that does not have an active policy with UIIC.</p>
          </button>
          <button class="choice" id="policy-renew" onclick="choosePolicy('renew',this)">
            <span class="tick">✓</span><h3>Renew my existing policy</h3><p>My vehicle already has an insurance policy and I want to renew it.</p>
          </button>
          <button class="choice" id="policy-other" onclick="choosePolicy('other',this)">
            <span class="tick">✓</span><h3>Switch from another insurer</h3><p>I have an active or recently expired policy with another insurer.</p>
          </button>
        </div>
        <div class="grid" style="margin-top:18px">
          <div class="col-6">
            <div class="field"><label>Previous insurer</label><select id="insurer"><option>United India Insurance</option><option>Other insurer</option><option>Not applicable</option></select></div>
          </div>
          <div class="col-6">
            <div class="field"><label>Previous policy / expiry date</label><input type="date" id="expiryDate"></div>
          </div>
        </div>
        <div class="footer-actions"><button class="btn btn-outline" onclick="go(1)">Back</button><button class="btn btn-primary" onclick="go(3)">Continue</button></div>
      </section>

      <!-- STEP 3 -->
      <section class="panel" id="panel3">
        <h2 class="section-title">Build your cover</h2>
